includes:
    - config/extension.neon

parameters:
    # parameters of this extension
    cognitive_complexity:
        class: 50
        function: 8

    # typed constants require PHP 8.3, but this package supports PHP 7.4+
    type_coverage:
        return_type: 99
        param_type: 99
        property_type: 99
        constant_type: 0

    symplify:
        naming: true
        complexity: true
        configurable: true
        static: true
        symfony: true
        symfonyConfig: true
        doctrine: true
        phpunit: true
        mocks: true
        ctor: true

    level: 8

    paths:
        - src
        - tests

    excludePaths:
        - "*/Fixture/*"
        - "*/Source/*"

    ignoreErrors:
        # skip as always string
        - '#Parameter \#1 \$currentWorkingDirectory of class PHPStan\\DependencyInjection\\ContainerFactory constructor expects string, string\|false given#'
